<Window x:Class="Spectra.Installer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Установка Spectra" Icon="Assets/spectra.ico" Width="600" Height="550" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#090E18" Foreground="#ECF6FF" FontFamily="Assets/#Minecraft Rus">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#ECF6FF"/><Setter Property="Background" Value="#23394B"/><Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="6,0"/><Setter Property="BorderBrush" Value="#446177"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#ECF6FF"/><Setter Property="Background" Value="#162638"/><Setter Property="BorderBrush" Value="#446177"/><Setter Property="Padding" Value="12"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#ECF6FF"/><Setter Property="Margin" Value="0,12"/><Setter Property="FontSize" Value="15"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="70"/></Grid.RowDefinitions>
  <Grid Background="#111E2C" MouseLeftButtonDown="DragHeader"><TextBlock Text="SPECTRA · УСТАНОВКА" Margin="20,0" VerticalAlignment="Center" Foreground="#91A9BE"/><Button Content="×" HorizontalAlignment="Right" Width="44" Margin="0" Click="CloseClick" Padding="0" BorderThickness="0" Background="Transparent"/></Grid>
  <StackPanel Grid.Row="1" Margin="40,26"><Image Source="Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,14"/><TextBlock FontFamily="Assets/#Spectra Pixel" x:Name="Heading" Text="Добро пожаловать в Spectra" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="Description" Text="Ваш Minecraft. Ваши сборки. Ваш стиль." Foreground="#A3BBD1" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,20"/>
   <StackPanel x:Name="LanguagePanel" Margin="0,10,0,0"><TextBlock Text="Язык лаунчера / Launcher language" HorizontalAlignment="Center" Margin="0,0,0,8"/><ComboBox x:Name="Language" Width="280" HorizontalAlignment="Center" Padding="10" SelectionChanged="LanguageChanged"/></StackPanel>
   <StackPanel x:Name="FolderPanel" Visibility="Collapsed"><TextBlock Text="Родительская папка установки" Margin="0,0,0,8"/><DockPanel><Button Content="Обзор…" DockPanel.Dock="Right" Click="BrowseClick"/><TextBox x:Name="Folder"/></DockPanel><TextBlock x:Name="TargetHint" Foreground="#A3BBD1" TextWrapping="Wrap" Margin="0,10"/></StackPanel>
   <StackPanel x:Name="ShortcutPanel" Visibility="Collapsed"><CheckBox x:Name="DesktopShortcut" Content="Создать ярлык на рабочем столе" IsChecked="True"/><CheckBox x:Name="StartShortcut" Content="Добавить Spectra в меню «Пуск»" IsChecked="True"/></StackPanel>
   <StackPanel x:Name="ProgressPanel" Visibility="Collapsed"><TextBlock x:Name="Detail" Text="Подготовка…" Foreground="#A3BBD1" TextWrapping="Wrap" Margin="0,12"/><ProgressBar x:Name="Progress" Height="6" Foreground="#B6DDFF" Background="#23394B" Maximum="100"/></StackPanel>
  </StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12"><Button x:Name="Back" Content="Назад" Visibility="Collapsed" Click="BackClick"/><Button x:Name="Next" Content="Далее →" Click="NextClick"/></StackPanel>
 </Grid>
</Window>
