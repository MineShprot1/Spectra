<Window x:Class="Spectra.Installer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Spectra Setup" Icon="Assets/spectra.ico" Width="980" Height="700" MinWidth="920" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#090E18" Foreground="#EDF3FC" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#91A2B8"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="20,13"/><Setter Property="MinHeight" Value="46"/><Setter Property="Background" Value="#192737"/><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="BorderBrush" Value="#35485E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="#050A11" Padding="0,0,0,3"><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="RenderTransform"><Setter.Value><TranslateTransform Y="2"/></Setter.Value></Setter></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#D0E9FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0B121D"/><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="BorderBrush" Value="#35485E"/><Setter Property="CaretBrush" Value="#D0E9FF"/><Setter Property="Padding" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="#142030"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#2B4057"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#243A51"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#142030" BorderBrush="#35485E" BorderThickness="1"><Grid Margin="14"><TextBlock Text="{Binding SelectedItem.Value,RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="#EDF3FC" Margin="0,0,25,0" FontFamily="Segoe UI"/><Path Data="M0 0 L5 5 L10 0" Stroke="#9FC8F3" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#142030" BorderBrush="#35485E" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="Margin" Value="0,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="18" Height="18" Background="#0B121D" BorderBrush="#607C99" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="Tick" Data="M3 8 L7 12 L14 4" Stroke="#9FC8F3" StrokeThickness="2" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="10,3,0,3" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border BorderBrush="#35485E" BorderThickness="1" Background="#090E18"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Background="#0D1520" MouseLeftButtonDown="DragHeader"><TextBlock Text="SPECTRA / SETUP" FontSize="11" Foreground="{StaticResource Muted}" Margin="20,0" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="−" Width="44" Padding="0" MinHeight="40" Background="Transparent" BorderThickness="0" Click="MinimizeClick"/><Button x:Name="CloseButton" Content="×" Width="44" Padding="0" MinHeight="40" Background="Transparent" BorderThickness="0" Click="CloseClick"/></StackPanel></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#0D1520" BorderBrush="#263548" BorderThickness="0,0,1,0"><Grid Margin="26,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><Image Source="Assets/logo.png" Width="58" Height="58" HorizontalAlignment="Left"/><TextBlock Text="SPECTRA" FontFamily="Assets/#Spectra Pixel" FontSize="21" Margin="0,22,0,10"/><TextBlock x:Name="SideIntro" Foreground="{StaticResource Muted}" LineHeight="23"/></StackPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="StepOne" Margin="0,14" FontSize="14"/><TextBlock x:Name="StepTwo" Margin="0,14" FontSize="14"/><TextBlock x:Name="StepThree" Margin="0,14" FontSize="14"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="WINDOWS / x64" FontSize="10" Foreground="#657C98"/><TextBlock x:Name="VersionLabel" Foreground="#657C98" Margin="0,7,0,0" FontSize="11"/></StackPanel></Grid></Border>
   <Grid Grid.Column="1" Margin="38,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="Heading" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="Description" Foreground="{StaticResource Muted}" Margin="0,12,0,24" LineHeight="22"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <StackPanel x:Name="LanguagePanel"><Border BorderBrush="#263548" BorderThickness="1" Background="#111C2A" Padding="22"><StackPanel><TextBlock x:Name="LanguageLabel" Margin="0,0,0,12"/><ComboBox x:Name="LanguagePicker" SelectionChanged="LanguageChanged"/><TextBlock Text="SPECTRA NETWORK · JAVA · BEDROCK" FontSize="10" Foreground="#657C98" Margin="0,22,0,0"/></StackPanel></Border><Border x:Name="ExistingPanel" BorderBrush="#355A70" BorderThickness="1" Background="#102332" Padding="18" Margin="0,20,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ExistingLabel"/><TextBlock x:Name="ExistingPath" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,14"/><Button x:Name="UpdateButton" HorizontalAlignment="Left" Click="UpdateClick"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="FolderPanel" Visibility="Collapsed"><TextBlock x:Name="FolderLabel" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Folder" MinWidth="200"/><Button Grid.Column="1" x:Name="Browse" Click="BrowseClick" Margin="8,0,0,0" Padding="15,12"/></Grid><TextBlock x:Name="TargetHint" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,18"/><Border Height="1" Background="#263548" Margin="0,0,0,12"/><CheckBox x:Name="DesktopShortcut" IsChecked="True"/><CheckBox x:Name="StartShortcut" IsChecked="True"/></StackPanel>
     <StackPanel x:Name="ReviewPanel" Visibility="Collapsed"><Border BorderBrush="#263548" BorderThickness="1" Background="#111C2A" Padding="22"><TextBlock x:Name="ReviewText" LineHeight="28"/></Border></StackPanel>
     <StackPanel x:Name="ProgressPanel" Visibility="Collapsed"><TextBlock x:Name="PhaseLabel" FontSize="18" Margin="0,20,0,14"/><ProgressBar x:Name="Progress" Height="8" Foreground="#9FC8F3" Background="#23344B" BorderThickness="0" Maximum="100"/><TextBlock x:Name="ProgressNumber" Margin="0,12" Foreground="#9FC8F3"/><TextBlock x:Name="Detail" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="20"/></StackPanel>
     <StackPanel x:Name="FinishPanel" Visibility="Collapsed"><Border BorderBrush="#47735B" BorderThickness="1" Background="#11251F" Padding="22"><StackPanel><TextBlock Text="✓" Foreground="#9DD8AE" FontSize="40"/><TextBlock x:Name="InstalledPath" Margin="0,12,0,0" Foreground="{StaticResource Muted}"/></StackPanel></Border><CheckBox x:Name="LaunchAfter" IsChecked="True" Margin="0,20,0,0"/></StackPanel>
     <Border x:Name="ErrorPanel" Visibility="Collapsed" BorderBrush="#B75C65" BorderThickness="1" Background="#2B171F" Padding="16" Margin="0,18,0,0"><TextBlock x:Name="ErrorText" Foreground="#F3B5BE"/></Border>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="2" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Cancel" HorizontalAlignment="Left" Click="CancelClick" Background="Transparent" BorderBrush="#263548"/><Button x:Name="Back" Grid.Column="1" Margin="0,0,10,0" Click="BackClick"/><Button x:Name="Next" Grid.Column="2" Click="NextClick" Background="#9FC8F3" Foreground="#101C2B" BorderBrush="#C3E3FF" MinWidth="130"/></Grid>
   </Grid>
  </Grid>
 </Grid></Border>
</Window>
