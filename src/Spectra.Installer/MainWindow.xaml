<Window x:Class="Spectra.Installer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Spectra Setup" Icon="Assets/spectra.ico" Width="660" Height="640" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#091119" Foreground="#EDF3FC" FontFamily="Assets/#Minecraft Rus">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#122742"/><Setter Property="Padding" Value="22,12"/><Setter Property="Margin" Value="6,0"/><Setter Property="FontFamily" Value="Assets/#Spectra Pixel"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="10" BorderBrush="#80D0E9FF" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D0E9FF" Offset="0"/><GradientStop Color="#9FC8F3" Offset="1"/></LinearGradientBrush></Border.Background><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E4F2FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="Background" Value="#162333"/><Setter Property="BorderBrush" Value="#446177"/><Setter Property="CaretBrush" Value="#D0E9FF"/><Setter Property="Padding" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="Margin" Value="0,12"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="4"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#30465F"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#243A51"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#162333" BorderBrush="#446177" BorderThickness="1" CornerRadius="8"><Grid Margin="12"><ContentPresenter Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate,RelativeSource={RelativeSource AncestorType=ComboBox}}" Margin="0,0,24,0"/><TextBlock Text="⌄" HorizontalAlignment="Right" FontFamily="Segoe UI" Foreground="#9FC8F3"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#111B2A" BorderBrush="#446177" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid ClipToBounds="True">
  <Ellipse Width="600" Height="600" Fill="#402868C8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-410,0,0"><Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect></Ellipse>
  <Ellipse Width="600" Height="600" Fill="#305E45AF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-250,-430"><Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect></Ellipse>
  <Grid Height="38" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="DragHeader"><TextBlock Text="SPECTRA SETUP" FontFamily="Assets/#Spectra Pixel" Foreground="#637892" FontSize="10" Margin="20,0" VerticalAlignment="Center"/><Button Content="×" Width="38" HorizontalAlignment="Right" Margin="0" Click="CloseClick" Padding="0"><Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template><Button.Foreground><SolidColorBrush Color="#8E9DB3"/></Button.Foreground></Button></Grid>
  <Border Margin="48,55,48,35" CornerRadius="19" BorderBrush="#33FFFFFF" BorderThickness="1" Background="#E6111B2A"><Border.Effect><DropShadowEffect BlurRadius="45" ShadowDepth="14" Opacity="0.35"/></Border.Effect>
   <Grid Margin="36,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20"><Image Source="Assets/logo.png" Width="30" Height="30" Margin="0,0,12,0"/><TextBlock Text="SPECTRA" FontFamily="Assets/#Spectra Pixel" FontSize="12" Foreground="#8694AB" VerticalAlignment="Center"/></StackPanel>
     <Border Width="68" Height="68" CornerRadius="18" BorderBrush="#66B4DECD" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16"><Border.Background><LinearGradientBrush><GradientStop Color="#2BA4CBE6"/><GradientStop Color="#227BB89B" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock x:Name="Badge" Text="↓" FontSize="34" Foreground="#B4DECD" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock x:Name="Heading" Text="Добро пожаловать в Spectra" FontFamily="Assets/#Spectra Pixel" FontSize="22" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="Description" Text="Ваш Minecraft. Ваши сборки. Ваш стиль." Foreground="#8E9DB3" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,18"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <StackPanel x:Name="LanguagePanel"><TextBlock x:Name="LanguageLabel" Text="Язык лаунчера / Launcher language" HorizontalAlignment="Center" Foreground="#8BA3BE" Margin="0,0,0,10"/><ComboBox x:Name="Language" HorizontalAlignment="Stretch" SelectionChanged="LanguageChanged"/></StackPanel>
     <StackPanel x:Name="FolderPanel" Visibility="Collapsed"><TextBlock x:Name="FolderLabel" Text="Родительская папка установки" Foreground="#8BA3BE" Margin="0,0,0,8"/><DockPanel><Button x:Name="Browse" Content="Обзор…" DockPanel.Dock="Right" Click="BrowseClick" Padding="12,10"/><TextBox x:Name="Folder"/></DockPanel><TextBlock x:Name="TargetHint" Foreground="#8E9DB3" TextWrapping="Wrap" Margin="0,10"/></StackPanel>
     <StackPanel x:Name="ShortcutPanel" Visibility="Collapsed"><CheckBox x:Name="DesktopShortcut" Content="Создать ярлык на рабочем столе" IsChecked="True"/><CheckBox x:Name="StartShortcut" Content="Добавить Spectra в меню «Пуск»" IsChecked="True"/></StackPanel>
     <StackPanel x:Name="ProgressPanel" Visibility="Collapsed"><TextBlock x:Name="Detail" Text="Подготовка…" Foreground="#8E9DB3" TextWrapping="Wrap" Margin="0,8,0,16"/><ProgressBar x:Name="Progress" Height="6" Foreground="#B6DDFF" Background="#23394B" Maximum="100"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="2"><Border Height="1" Background="#33C3DBFF" Width="200" HorizontalAlignment="Center" Margin="0,16,0,18"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Back" Content="Назад" Visibility="Collapsed" Click="BackClick"/><Button x:Name="Next" Content="Далее →" Click="NextClick"/></StackPanel></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
