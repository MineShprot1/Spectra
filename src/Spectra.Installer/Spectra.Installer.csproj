<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><Version>0.17.1</Version><OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>SpectraSetup</AssemblyName><ApplicationIcon>Assets\spectra.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest><PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile></PropertyGroup>
 <ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/><Resource Include="Assets\logo.png"/><Resource Include="Assets\minecraft.ttf"/><Resource Include="Assets\spectra-pixel.ttf"/><Resource Include="Assets\spectra.ico"/><EmbeddedResource Include="payload.zip" LogicalName="Spectra.Payload" Condition="Exists('payload.zip')"/></ItemGroup>
 <Target Name="RequirePayload" BeforeTargets="Publish"><Error Condition="!Exists('payload.zip')" Text="Run BuildInstaller.ps1 to create the launcher payload first."/></Target>
</Project>
