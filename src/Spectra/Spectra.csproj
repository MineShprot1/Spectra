<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <Version>0.17.0</Version><ApplicationIcon>Assets\spectra.ico</ApplicationIcon><AssemblyName>Spectra</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\spectra.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.1.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Content Include="BedrockBridge.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ApplyUpdate.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="build-commit-name.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('build-commit-name.txt')" />
    <Content Include="build-commit.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('build-commit.txt')" />
    <Content Include="microsoft-oauth.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Web\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
